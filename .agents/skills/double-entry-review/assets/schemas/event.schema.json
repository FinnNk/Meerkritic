{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Double-Entry Review event v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "pair_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
    },
    "recorded_at": {
      "type": "string",
      "minLength": 1
    },
    "previous_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "kind": {
      "enum": [
        "observation",
        "verification",
        "review",
        "feedback",
        "test-disposition",
        "publication",
        "approval",
        "integration",
        "handoff"
      ]
    },
    "round_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "actor": {
      "type": "object",
      "properties": {
        "client": {
          "type": "string",
          "minLength": 1
        },
        "cli_version": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "session": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "client",
        "cli_version",
        "model",
        "session"
      ],
      "additionalProperties": false
    },
    "payload": {
      "type": "object"
    },
    "event_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "sequence",
    "pair_id",
    "recorded_at",
    "previous_hash",
    "kind",
    "round_id",
    "actor",
    "payload",
    "event_hash"
  ],
  "additionalProperties": false
}
